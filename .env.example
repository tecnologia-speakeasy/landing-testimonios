# =============================================================================
# Landing de testimonios — Speak Easy
# Copia este archivo como `.env.local` y rellena los valores reales.
# `.env.local` NUNCA se sube a git. En Vercel, carga estas mismas variables en
# Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (conexión por host)
# Es la misma base que usan landing-referidos y landing-auth-zoom; lo que cambia
# es el esquema.
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu-password
PGDATABASE=speakeasy

# Esquema donde vive la tabla de este proyecto (estudiantes), separada de
# `referidos`, `auth_lanzamiento` y del resto de la base.
PGSCHEMA=testimonios

# SSL de la conexión: `require` (proveedores gestionados: Neon, Supabase, RDS,
# Railway, Render...) o `disable` (Postgres local o red privada).
# Con `require` se cifra la conexión sin verificar la cadena de certificados
# (rejectUnauthorized:false), que es lo que aceptan esos proveedores.
PGSSL=require

# Nº máximo de conexiones del pool. En Vercel (serverless) conviene un valor
# bajo (1–3) y usar el endpoint "pooler"/pgBouncer de tu proveedor.
PGPOOL_MAX=3
