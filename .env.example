# =============================================================================
# Landing de testimonios — Speak Easy
# Copia este archivo como `.env.local` y rellena los valores reales.
# `.env.local` NUNCA se sube a git.
#
# Las variables PG* las usa `npm run migrate` en tu equipo. En producción las
# usa la Lambda `api-landings`: cárgalas en la consola de AWS, en
# Configuration → Environment variables.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (conexión por host)
# Es la misma base que usan landing-referidos y landing-auth-zoom; lo que cambia
# es el esquema.
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu-password
PGDATABASE=speakeasy

# Esquema donde vive la tabla de este proyecto (estudiantes), separada de
# `referidos`, `auth_lanzamiento` y del resto de la base.
PGSCHEMA=testimonios

# SSL de la conexión: `require` (proveedores gestionados o servidor propio con
# SSL) o `disable` (Postgres local o red privada).
# Con `require` se cifra la conexión sin verificar la cadena de certificados
# (rejectUnauthorized:false), que es lo que aceptan esos servidores.
PGSSL=require

# -----------------------------------------------------------------------------
# API de las landings (opcional)
# URL de la Lambda a la que el formulario envía los datos. Si no se define, se
# usa la de producción (ver astro.config.mjs). Queda escrita en la página al
# compilar: no es secreta.
# -----------------------------------------------------------------------------
# PUBLIC_API_URL=https://xxxxxxxx.lambda-url.us-east-2.on.aws
